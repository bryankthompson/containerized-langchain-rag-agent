{
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build",
    "declaration": true,
    "experimentalDecorators": true,
    "strict": false,
    "target": "es2022",
    "module": "NodeNext",
    "lib": ["ES2021", "ES2022.Object", "DOM"],
    "sourceMap": true
  },
  "exclude": ["node_modules/", "dist/", "tests/"],
  "include": ["./src"]
}
